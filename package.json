{
  "name": "teampulse",
  "version": "1.1.0",
  "description": "AI-powered CLI for meeting analysis",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./mcp": "./src/mcp-server.js"
  },
  "bin": {
    "teampulse": "./src/index.js",
    "teampulse-mcp": "./src/mcp-server.js"
  },
  "files": [
    "src",
    "evals",
    "server.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "eval": "node src/index.js eval --provider fixture",
    "mcp-server": "node src/mcp-server.js"
  },
  "engines": { "node": ">=18" },
  "keywords": ["cli", "ai", "meetings", "mcp"],
  "author": "Maria Del Carmen Contreras",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcontrerasmalpar-pixel/teampulse.git"
  },
  "homepage": "https://github.com/mcontrerasmalpar-pixel/teampulse#readme",
  "bugs": { "url": "https://github.com/mcontrerasmalpar-pixel/teampulse/issues" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "commander": "^12.1.0",
    "ora": "^8.2.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
